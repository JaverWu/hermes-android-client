<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chat_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg"
        app:title="@string/title_chat"
        app:titleTextColor="@color/text_on_blue"
        app:titleTextAppearance="@style/ToolbarTitle18"
        app:subtitleTextColor="@color/text_on_blue_secondary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_on_blue"
        app:menu="@menu/chat_menu" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <TextView
            android:id="@+id/textEmptyChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:text="@string/empty_chat"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 白色圆角输入条 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/imageAttach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_attach"
                android:src="@drawable/ic_attach"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/editInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/hint_message"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:imeOptions="actionSend"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:padding="12dp" />

            <ImageButton
                android:id="@+id/buttonSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_blue"
                android:contentDescription="@string/action_send"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
